# 운영 compose(deploy/compose.yaml)의 설정. 서버의 /etc/akkimpyo/app.env에 root 소유, 권한 600으로 둔다.
# 값은 레포에 두지 않는다. 이 파일에는 이름과 설명만 있다.
#
# 형식
# - "이름=값" 한 줄에 하나. 값에 따옴표, 공백, '$'를 쓰지 않는다(compose가 '$'를 변수로 읽는다).
# - 여기 없는 이름을 넣지 않는다. 배포 스크립트가 deploy/env.allowlist에 없는 이름이 있으면 배포하지 않는다.
# - SERVER_IMAGE, WEB_IMAGE, SW_DISABLE은 여기 두지 않는다. deploy/production.env에서 배포 스크립트가 넘긴다.
# - SPRING_PROFILES_ACTIVE, JDK_JAVA_OPTIONS는 compose.yaml에 고정돼 있다. 여기 두지 않는다.
# - 비밀값은 셸 기록이나 화면에 남지 않게 명령의 출력을 바로 파일에 붙인다. 예:
#     printf 'DB_PASSWORD=%s\n' "$(openssl rand -hex 32)" >> /etc/akkimpyo/app.env

# --- 필수 ---

# 사이트 주소. https://이름 꼴(포트, 경로, 끝 빗금 없이 소문자). 프록시의 사이트 주소이자 서버의 WEB_ORIGIN이다.
# 주소가 정해지기 전에는 비워 둔다(비어 있으면 compose가 뜨지 않는다). 바꾸면 proxy와 server를 함께 다시 띄운다.
SITE_ADDRESS=

# 서버의 DB 접속 주소. 값은 jdbc:postgresql://db:5432/accountbook 이다(compose.yaml의 db 서비스와 POSTGRES_DB).
# 주소에 logServerErrorDetail 같은 연결 설정을 붙이지 않는다.
DB_URL=

# 서버가 쓰는 DB 역할의 이름과 비밀번호. 빈 DB를 처음 띄울 때 db-init.sh가 이 값으로 역할을 만든다.
# 이름은 postgres가 아닌 것(예: accountbook). 비밀번호는 openssl rand -hex 32의 출력.
# DB를 만든 뒤 이 파일의 값만 바꾸면 DB의 역할은 바뀌지 않아 서버가 접속하지 못한다. 바꿀 때는 DB에서 ALTER ROLE도 한다.
DB_USERNAME=
DB_PASSWORD=

# access token 서명 키. 표준 Base64, 32바이트 이상 난수. openssl rand -base64 32의 출력. 로컬과 다른 값이다.
# 바꾸면 발급된 access token이 모두 무효가 된다.
ACCESS_TOKEN_SIGNING_KEY=

# --- 선택(비워 두면 기본값) ---

# 호스트에 여는 프록시 포트. "포트" 또는 "주소:포트". 기본값 80, 443.
# 다른 서비스와 겹칠 때만 바꾼다. 바꾸면 인증서를 받지 못할 수 있다(docs/ops/domain.md 1절 5번).
PROXY_HTTP_PORT=
PROXY_HTTPS_PORT=

# 접근 로그(IP가 남는다)를 남겨 두는 날 수. 기본값 14(#52 범위 보강 2). #23에서 정하는 값으로 바꾼다.
ACCESS_LOG_KEEP_DAYS=
