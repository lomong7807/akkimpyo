# 백업 설정. 서버의 /etc/akkimpyo/backup.env에 root 소유, 권한 600으로 둔다.
# "이름=값" 줄만 읽는다. 셸로 실행하지 않으므로 값에 따옴표를 붙이지 않는다. 비밀값은 여기 두지 않는다.

# Object Storage 네임스페이스와 버킷 이름(필수).
OCI_NAMESPACE=
OCI_BUCKET=

# 아래는 기본값이 있다. 바꿀 때만 주석을 풀고 값을 쓴다.

# DB 컨테이너의 compose 프로젝트와 서비스 이름. 기본값 akkimpyo, db.
#COMPOSE_PROJECT=
#COMPOSE_DB_SERVICE=

# DB 이름과 덤프할 사용자(역할을 뜨므로 슈퍼유저). 기본값은 DB 컨테이너의 POSTGRES_DB, POSTGRES_USER.
# DB 컨테이너 안의 로컬 접속에 비밀번호가 없어야 한다(postgres 공식 이미지의 기본값).
#BACKUP_DB_NAME=
#BACKUP_DB_USER=

# age 실행 파일. 기본값 /opt/akkimpyo/bin/age.
#AGE_BIN=

# 암호화에 쓸 age 공개키 파일. 기본값 /etc/akkimpyo/backup-recipients.txt.
#AGE_RECIPIENTS_FILE=

# 명세표 쿼리 파일(docs/db/integrity-checks.sql의 사본). 기본값 /opt/akkimpyo/share/integrity-checks.sql.
#INTEGRITY_SQL_FILE=

# 올리기에 쓰는 OCI CLI 이미지. 기본값은 스크립트에 digest로 고정돼 있다.
#OCI_CLI_IMAGE=

# 평문을 잠깐 두는 폴더. 기본값 /run/akkimpyo-backup(메모리). 디스크에 있는 폴더로 바꾸지 않는다.
#BACKUP_WORK_DIR=

# 마지막 성공 기록과 못 보낸 알림을 두는 폴더. 기본값 /var/lib/akkimpyo-backup.
#BACKUP_STATE_DIR=

# 다른 백업이 돌고 있을 때 기다리는 시간(초). 기본값 600.
#BACKUP_LOCK_WAIT_SECONDS=

# 텔레그램 토큰과 chat id 파일. 기본값 /etc/akkimpyo/telegram.env. root 소유, 권한 600.
# 그 파일에는 TELEGRAM_BOT_TOKEN과 TELEGRAM_CHAT_ID 두 줄을 둔다.
#TELEGRAM_ENV_FILE=

# 시험할 때만 쓴다. 정하면 Object Storage 대신 이 폴더에 둔다. 운영에서는 정하지 않는다.
#BACKUP_LOCAL_DIR=
