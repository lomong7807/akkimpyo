wait
config "BACKUP_LOCAL_DIR=$STORE"

# DB 잠금으로 덤프를 멈춰 놓고 백업을 시작한다.
start_blocked_backup() {
  docker exec --detach "$TEST_ID-db" psql -X -q -U accountbook -d accountbook \
    -c 'BEGIN' -c 'LOCK TABLE account IN ACCESS EXCLUSIVE MODE' -c 'SELECT pg_sleep(60)'
  sleep 1
  reset_alerts
  setsid "$BIN/backup" >/tmp/out 2>"$LOG" </dev/null &
  blocked=$!
  for _ in $(seq 100); do
    compgen -G "$RUN_DIR/run.*/plain/db.dump.partial" >/dev/null && break
    sleep 0.1
  done
  sleep 0.5
}
unblock() {
  sql -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE query LIKE 'SELECT pg_sleep%'" >/dev/null
}

section '실패: 도는 중에 멈춘다(systemd의 SIGTERM)'
start_blocked_backup
kill -TERM -- "-$blocked"
rc=0
wait "$blocked" || rc=$?
assert '0이 아닌 코드로 끝난다' [ "$rc" -ne 0 ]
assert "알림이 간다($(tail -n 1 "$ALERTS"))" alerted '단계: 덤프'
assert '평문이 남지 않는다' clean "$RUN_DIR"
unblock

section '실패: 도는 중에 강제 종료된다(SIGKILL). 남은 평문은 다음 백업이 지운다'
start_blocked_backup
kill -KILL -- "-$blocked"
wait "$blocked" 2>/dev/null || true
assert '평문 폴더가 남아 있다' compgen -G "$RUN_DIR/run.*"
unblock
run_backup
assert '다음 백업이 성공한다' equal 0 "$rc"
assert '남은 평문을 지웠다' clean "$RUN_DIR"

section '경고: 덤프가 직전보다 20% 넘게 줄었다'
sed -i 's/^dump_bytes=.*/dump_bytes=99999999/' "$STATE/last-success"
sleep 1
run_backup
assert '백업은 성공이다' equal 0 "$rc"
assert '객체 이름을 낸다' [ -s "$STORE/$out" ]
assert '알림이 간다' alerted '20% 넘게 줄었다'
sleep 1
run_backup
assert '다음 백업은 알리지 않는다' no_alert

section '알림을 못 보내면 남겨 뒀다가 backup-check가 다시 보낸다'
sed -i 's/^dump_bytes=.*/dump_bytes=99999999/' "$STATE/last-success"
touch /tmp/notify-fails
sleep 1
run_backup
assert '백업은 성공이다' equal 0 "$rc"
run_check
assert '아직 못 보내면 0이 아닌 코드다' [ "$rc" -ne 0 ]
rm /tmp/notify-fails
run_check
assert '보냈다' alerted '늦게 보낸 알림.*20% 넘게 줄었다'
assert '0으로 끝난다' equal 0 "$rc"
run_check
assert '한 번만 보낸다' no_alert

