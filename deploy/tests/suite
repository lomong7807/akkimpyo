section '복원 훈련: 복호화, 복원, 명세표, 점검, 서버 기동까지'
run_drill --store "$STORE" --server-jar "$WORK/app.jar" --keep-copy "$WORK/copy"
assert '통과하고 0으로 끝난다' equal 0 "$rc"
sed -n '/^복원 훈련 결과/,$p' "$LOG" | sed 's/^/    /'
assert '명세표를 맞춰 봤다' logged '^- 명세표: 통과'
assert '점검 13개를 돌렸다' logged '^- 점검 쿼리: 통과 (13개 모두 0건)'
assert 'Flyway validate를 봤다' logged '^- Flyway validate: 통과 (Successfully validated'
assert '서버가 떴다' logged '^- 서버 기동: 통과'
assert '쿼리 파일이 같으면 말하지 않는다' not logged '쿼리 파일'
assert '컨테이너가 남지 않는다' equal '' "$(docker ps --all --quiet --filter 'name=akkimpyo-drill')"
assert '평문이 남지 않는다' equal '' "$(find /tmp -maxdepth 1 -name 'akkimpyo-drill*')"

section '복원 훈련: 서버 기동을 건너뛰면 불완전, 사본은 하나만 남는다'
sleep 1
run_backup
run_drill --store "$STORE" --skip-server --keep-copy "$WORK/copy"
assert '2로 끝난다' equal 2 "$rc"
assert '사본은 가장 새것 하나다' equal "$(basename "$out")" "$(cd "$WORK/copy" && echo ./*.tar.age | sed 's|^\./||')"
run_drill --file "$WORK/copy/$(basename "$out")" --skip-server
assert '사본 파일로도 된다' equal 2 "$rc"

section '복원 훈련: 서버의 쿼리 파일이 레포와 다르면 알려 주고, 실패로 만들지는 않는다'
{
  cat "$REPO/docs/db/integrity-checks.sql"
  echo '-- 옛 파일'
} >/tmp/old-checks.sql
config "BACKUP_LOCAL_DIR=$STORE" INTEGRITY_SQL_FILE=/tmp/old-checks.sql
sleep 1
run_backup
run_drill --store "$STORE" --skip-server
assert '결과에 나온다' logged '^- 쿼리 파일: 다름'
assert '실패가 아니다(건너뛴 서버 때문에 불완전)' equal 2 "$rc"
assert '명세표와 점검은 그대로 통과다' logged '^- 점검 쿼리: 통과'
config "BACKUP_LOCAL_DIR=$STORE"
sleep 1
run_backup
run_drill --store "$STORE" --skip-server --keep-copy "$WORK/copy"

section '복원 훈련: FileVault가 꺼져 있으면 경고하고 계속한다'
mkdir -p /tmp/fake-fdesetup
printf '#!/bin/sh\necho "FileVault is Off."\n' >/tmp/fake-fdesetup/fdesetup
chmod 755 /tmp/fake-fdesetup/fdesetup
PATH=/tmp/fake-fdesetup:$PATH run_drill --store "$STORE" --skip-server
assert '경고한다' logged '주의: FileVault가 꺼져 있다'
assert '멈추지 않는다' equal 2 "$rc"
printf '#!/bin/sh\necho "FileVault is On."\n' >/tmp/fake-fdesetup/fdesetup
PATH=/tmp/fake-fdesetup:$PATH run_drill --store "$STORE" --skip-server
assert '켜져 있으면 경고하지 않는다' not logged 'FileVault'

section '복원 훈련: 잘못된 것을 잡아낸다'
work_dir=$(mktemp -d)
age-keygen -o /tmp/other.txt 2>/dev/null
rc=0
"$REPO/scripts/restore-drill" --identity /tmp/other.txt --store "$STORE" --skip-server >"$LOG" 2>&1 || rc=$?
assert '다른 개인키' equal 1 "$rc"
assert '  복호화 실패로 보고한다' logged '^- 복호화: 실패'
cp "$STORE/$out" "$STORE/$out.sha256" "$work_dir/"
printf 'x' >>"$work_dir/$(basename "$out")"
run_drill --file "$work_dir/$(basename "$out")" --skip-server
assert '바뀐 암호화 파일' logged '^- sha256: 실패'

# 백업 안의 파일 하나를 바꿔 다시 묶는다. 안의 sha256 목록도 맞춘다.
# repack 파일 명령...
repack() {
  local entry=$1
  shift
  rm -rf "$work_dir"
  mkdir -p "$work_dir/plain"
  "$BIN/age" --decrypt --identity "$KEY" "$STORE/$out" | tar -xf - -C "$work_dir/plain"
  "$@" "$work_dir/plain/$entry"
  (
    cd "$work_dir/plain"
    files=(meta.txt manifest.txt integrity-checks.sql globals.sql db.dump)
    sha256sum "${files[@]}" >SHA256SUMS
    tar -cf - SHA256SUMS "${files[@]}" | "$BIN/age" --encrypt -R /etc/akkimpyo/backup-recipients.txt -o "$work_dir/x.tar.age"
  )
  (cd "$work_dir" && sha256sum x.tar.age >x.tar.age.sha256)
  run_drill --file "$work_dir/x.tar.age" --skip-server --keep-copy "$WORK/copy"
}
repack manifest.txt sed -i 's/^transaction,5000$/transaction,4999/'
assert '행 수가 다른 명세표' logged '^- 명세표: 실패'
assert '  좋은 옛 사본을 지우지 않는다' [ -s "$WORK/copy/$(basename "$out")" ]
assert '  나쁜 파일을 사본으로 두지 않는다' not test -e "$WORK/copy/x.tar.age"
repack globals.sql ln --symbolic --force /etc/hostname
assert '심볼릭 링크가 든 백업' logged '보통 파일이 아닌 것'
repack db.dump truncate --size=100K
assert '잘린 덤프' logged '^- 복원: 실패'
assert '1로 끝난다' equal 1 "$rc"

sql -c "INSERT INTO transaction SELECT (jsonb_populate_record(t, jsonb_build_object('id', md5('bad')))).* FROM transaction t LIMIT 1"
sleep 1
run_backup
run_drill --store "$STORE" --skip-server
assert '라인 없는 거래(점검 2)' logged '^- 점검 쿼리: 실패 (점검 2: 1건,)'
assert '1로 끝난다' equal 1 "$rc"
sql -c "DELETE FROM transaction WHERE id = md5('bad')::uuid"

