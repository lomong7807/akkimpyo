run_check
rm /tmp/notify-fails
assert '알림을 못 보내면 보낸 것으로 치지 않는다' not test -e "$STATE/last-stale-alert"
rm "$STATE/last-success"
run_check
assert '기록이 없어도 알린다' alerted '기록이 없다'

