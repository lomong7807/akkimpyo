section '26시간 점검'
ago() { printf 'epoch=%s\n' $(($(date +%s) - $1)); }
ago $((25 * 3600)) >"$STATE/last-success"
run_check
assert '25시간 전이면 조용히 0으로 끝난다' equal 0 "$rc"
assert '  알림이 없다' no_alert
ago $((27 * 3600)) >"$STATE/last-success"
run_check
