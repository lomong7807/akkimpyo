#!/usr/bin/env bash
# deploy/tests/run이 시험 컨테이너 안에서 부른다. 하나라도 어긋나면 그 자리에서 1로 끝난다.
set -euo pipefail
export LC_ALL=C.UTF-8

: "${TEST_ID:?}" "${REPO:?}" "${WORK:?}"
JRE_IMAGE=eclipse-temurin:21.0.13_9-jre-noble@sha256:b4f9d2a0bc273417cf5219b7b832bbf0493ed500b7b57d5001d9f83374659060
BIN=/opt/akkimpyo/bin
RUN_DIR=/run/akkimpyo-backup
STATE=/var/lib/akkimpyo-backup
STORE=$WORK/store
ALERTS=/tmp/alerts
LOG=/tmp/log
KEY=/tmp/identity.txt

section() { printf '\n[%3d초] %s\n' "$SECONDS" "$1"; }

# assert 설명 명령...
assert() {
  local what=$1
  shift
  if ! "$@"; then
    printf '  실패: %s\n--- 로그\n' "$what"
    cat "$LOG"
    printf -- '--- 알림\n'
    cat "$ALERTS"
    exit 1
  fi
  printf '  ok: %s\n' "$what"
}
not() { ! "$@"; }
equal() { [[ $1 == "$2" ]] || { printf '    기대 "%s", 실제 "%s"\n' "$1" "$2"; false; }; }
alerted() { grep -q -- "$1" "$ALERTS"; }
no_alert() { [[ ! -s $ALERTS ]]; }
logged() { grep -q -- "$1" "$LOG"; }
clean() { [[ -z $(find "$1" -mindepth 1 ! -name lock 2>/dev/null) ]]; }
bundles() { find "$STORE/$1" -name '*.tar.age' 2>/dev/null | wc -l; }
reset_alerts() { : >"$ALERTS"; }

# 설정 파일을 새로 쓴다. 인자는 "이름=값"이다.
config() {
  printf '%s\n' "COMPOSE_PROJECT=$TEST_ID" "$@" >/etc/akkimpyo/backup.env
}

run_backup() {
  reset_alerts
  rc=0
  out=$("$BIN/backup" 2>"$LOG" </dev/null) || rc=$?
}

# 실패해야 하는 백업. 알림이 가고, 평문과 새 객체가 남지 않는다.
# expect_failure 알림에 나올 단계
expect_failure() {
  local before
  before=$(find "$STORE" -type f | wc -l)
  run_backup
  assert '0이 아닌 코드로 끝난다' [ "$rc" -ne 0 ]
  assert '표준 출력에 객체 이름을 내지 않는다' equal '' "$out"
  assert "알림이 간다($(tail -n 1 "$ALERTS"))" alerted "단계: $1"
  assert '올라간 것이 없다' equal "$before" "$(find "$STORE" -type f | wc -l)"
}

run_check() {
  reset_alerts
  rc=0
  "$BIN/backup-check" >"$LOG" 2>&1 || rc=$?
}

run_drill() {
  rc=0
  "$REPO/scripts/restore-drill" --identity "$KEY" "$@" >"$LOG" 2>&1 || rc=$?
}

db() { docker exec -i "$TEST_ID-db" "$@"; }
sql() { db psql -X -q -A -t -v ON_ERROR_STOP=1 -U accountbook -d accountbook "$@"; }

start_db() {
  docker start "$TEST_ID-db" >/dev/null
  until docker exec "$TEST_ID-db" pg_isready --quiet --host 127.0.0.1; do sleep 0.3; done
}

# ---------------------------------------------------------------------------
section 'shellcheck'
: >"$LOG"
reset_alerts
assert 'shellcheck' shellcheck --external-sources --source-path="$REPO" \
  "$REPO"/deploy/bin/* "$REPO"/deploy/tests/run "$REPO"/deploy/tests/suite "$REPO"/scripts/restore-drill \
  "$REPO"/scripts/server-container.sh

section '설치'
install -d -m 755 /opt/akkimpyo/share
install -m 755 "$REPO"/deploy/bin/backup "$REPO"/deploy/bin/backup-check "$BIN/"
install -m 644 "$REPO"/deploy/bin/backup-lib.sh "$BIN/"
install -m 644 "$REPO"/docs/db/integrity-checks.sql /opt/akkimpyo/share/
install -d -m 700 /etc/akkimpyo
install -m 644 "$REPO"/deploy/systemd/* /etc/systemd/system/
age-keygen() { "$BIN/age-keygen" "$@"; }
age-keygen -o "$KEY" 2>/dev/null
age-keygen -y "$KEY" >/etc/akkimpyo/backup-recipients.txt
export AGE_BIN=$BIN/age
# 가짜 전송기. /tmp/notify-fails가 있으면 전송에 실패한다.
cat >"$BIN/notify-telegram" <<'SH'
#!/bin/sh
[ ! -e /tmp/notify-fails ] || exit 1
cat >>/tmp/alerts
SH
chmod 755 "$BIN/notify-telegram"
mkdir -p "$STORE"
config "BACKUP_LOCAL_DIR=$STORE"

section 'systemd 단위 파일'
assert '형식이 맞다' systemd-analyze verify /etc/systemd/system/akkimpyo-backup{,-check}.{service,timer}
next=$(TZ=UTC systemd-analyze calendar --base-time='2026-11-25 00:00:00 UTC' '*-*-* 03:30:00 Asia/Seoul')
assert '03:30 한국 시각(18:30 UTC)에 돈다' grep -q '2026-11-25 18:30:00 UTC' <<<"$next"

section '판정 함수'
# shellcheck source=deploy/bin/backup-lib.sh
. "$BIN/backup-lib.sh"
at() { date -d "$1" +%s; }
assert '토요일 23:59:59 KST는 앞 일요일 주다' equal 2026-11-22 "$(week_sunday "$(at '2026-11-28 23:59:59 +0900')")"
assert '일요일 00:00:00 KST에 새 주가 된다' equal 2026-11-29 "$(week_sunday "$(at '2026-11-29 00:00:00 +0900')")"
assert '일요일 03:30 KST(UTC로는 토요일)는 그 일요일 주다' equal 2026-11-29 "$(week_sunday "$(at '2026-11-28 18:30:00 +0000')")"
assert '달이 바뀌어도 앞 일요일이다' equal 2026-11-29 "$(week_sunday "$(at '2026-12-05 12:00:00 +0900')")"
assert '해가 바뀌어도 앞 일요일이다' equal 2026-12-27 "$(week_sunday "$(at '2027-01-02 00:00:00 +0900')")"
assert '정확히 26시간은 늦은 것이 아니다' not is_stale 100000 $((100000 - 26 * 3600))
assert '26시간 1초는 늦은 것이다' is_stale 100000 $((100000 - 26 * 3600 - 1))
assert '정확히 20% 감소는 알리지 않는다' not shrank 1000 800
assert '20%를 넘는 감소는 알린다' shrank 1000 799
assert '점검 번호를 모두 찾는다' equal "$(grep -c '^-- \[점검' "$REPO/docs/db/integrity-checks.sql")" \
  "$(check_numbers "$REPO/docs/db/integrity-checks.sql" | wc -l)"
assert '점검 1과 점검 11을 구분한다' equal 1 "$(sql_section "$REPO/docs/db/integrity-checks.sql" '점검 1' | grep -c '^-- \[')"

# ---------------------------------------------------------------------------
section '운영을 흉내 낸 DB(읽기 전용 파일 시스템, 권한 없음)에 서버가 Flyway 스키마를 만든다'
docker network create "$TEST_ID" >/dev/null
docker run --detach --name "$TEST_ID-db" --network "$TEST_ID" --network-alias db \
  --label "com.docker.compose.project=$TEST_ID" --label com.docker.compose.service=db \
  --user postgres --read-only --cap-drop ALL --security-opt no-new-privileges \
  --tmpfs /tmp --tmpfs /var/run/postgresql --volume "$TEST_ID-db:/var/lib/postgresql/data" \
  --env POSTGRES_DB=accountbook --env POSTGRES_USER=accountbook --env POSTGRES_PASSWORD=accountbook \
  postgres:17 >/dev/null
until docker exec "$TEST_ID-db" pg_isready --quiet --host 127.0.0.1; do sleep 0.3; done
# shellcheck source=scripts/server-container.sh
. "$REPO/scripts/server-container.sh"
create_server --name "$TEST_ID-app" --network "$TEST_ID" \
  --env DB_URL=jdbc:postgresql://db:5432/accountbook --env DB_USERNAME=accountbook --env DB_PASSWORD=accountbook \
  "$JRE_IMAGE" java -jar /app.jar
docker cp --quiet "$WORK/app.jar" "$TEST_ID-app:/app.jar"
docker start "$TEST_ID-app" >/dev/null
for _ in $(seq 120); do
  docker logs "$TEST_ID-app" >"$LOG" 2>&1
  grep -q 'Started .*Application' "$LOG" && break
  sleep 0.5
done
assert '서버가 떴다' logged 'Started .*Application'
docker rm --force "$TEST_ID-app" >/dev/null
sql <"$REPO/deploy/tests/seed.sql"
# 운영에는 소유자와 앱 실행용 역할이 나뉜다(#52). 역할도 복원되는지 본다.
sql -c "CREATE ROLE app_rw NOLOGIN; GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_rw"
assert '시험 데이터가 들어갔다' equal 5000 "$(sql -c 'SELECT count(*) FROM transaction')"

# ---------------------------------------------------------------------------
section '백업 성공'
run_backup
assert '0으로 끝난다' equal 0 "$rc"
assert '표준 출력은 객체 이름 한 줄이다' grep -qxE 'daily/akkimpyo-[0-9]{8}T[0-9]{6}KST\.tar\.age' <<<"$out"
first=$out
assert '그 이름으로 올라갔다' [ -s "$STORE/$first" ]
sha256_ok() { (cd "$(dirname "$1")" && sha256sum --check --status "$(basename "$1").sha256"); }
assert 'sha256이 맞다' sha256_ok "$STORE/$first"
assert '첫 백업은 weekly에도 올라갔다' equal 1 "$(bundles weekly)"
assert '올라간 것은 age 파일과 sha256뿐이다' equal '' "$(find "$STORE" -type f ! -name '*.tar.age' ! -name '*.tar.age.sha256')"
assert 'age로 암호화됐다' grep -aq '^age-encryption.org/v1' "$STORE/$first"
assert '평문이 남지 않는다' clean "$RUN_DIR"
assert '작업 폴더는 root만 연다' equal 700 "$(stat -c %a "$RUN_DIR")"
assert '알림이 없다' no_alert

section '같은 주의 다음 백업은 weekly에 올리지 않는다. 지난주 것이 마지막이면 올린다'
sleep 1
run_backup
assert '0으로 끝난다' equal 0 "$rc"
assert 'daily가 늘었다' equal 2 "$(bundles daily)"
assert 'weekly는 그대로다' equal 1 "$(bundles weekly)"
echo 'sunday=2020-01-05' >"$STATE/last-weekly"
sleep 1
run_backup
assert 'weekly가 늘었다' equal 2 "$(bundles weekly)"

