section '텔레그램 전송기: 토큰이 명령줄과 출력에 나오지 않는다'
mkdir -p /tmp/fake-bin
cat >/tmp/fake-bin/curl <<'SH'
#!/bin/bash
printf '%s\n' "$@" >/tmp/curl-args
while (($#)); do
  [[ $1 == --config ]] && cat "$2" >/tmp/curl-config
  shift
done
cat >/tmp/curl-stdin
echo 'curl: 12345:test-token' >&2
exit "${FAKE_CURL_RC:-0}"
SH
chmod 755 /tmp/fake-bin/curl
telegram() {
  rc=0
  printf '%s' "$1" | PATH=/tmp/fake-bin:$PATH TELEGRAM_ENV_FILE=/tmp/telegram.env \
    "$REPO/deploy/bin/notify-telegram" >"$LOG" 2>&1 || rc=$?
}
install -m 600 /dev/null /tmp/telegram.env
printf 'TELEGRAM_BOT_TOKEN=12345:test-token\nTELEGRAM_CHAT_ID=-100200\n' >/tmp/telegram.env
telegram '여러 줄
"따옴표" & 기호'
assert '0으로 끝난다' equal 0 "$rc"
assert '주소에 토큰을 넣었다' grep -qx 'url = "https://api.telegram.org/bot12345:test-token/sendMessage"' /tmp/curl-config
assert 'chat id를 넣었다' grep -qx 'data-urlencode = "chat_id=-100200"' /tmp/curl-config
assert '글을 그대로 보냈다' equal '여러 줄
"따옴표" & 기호' "$(cat /tmp/curl-stdin)"
assert '명령줄에 토큰이 없다' not grep -q 'test-token\|100200' /tmp/curl-args
assert '출력에 토큰이 없다' not logged 'test-token'
FAKE_CURL_RC=22 telegram '글'
assert '전송 실패면 0이 아닌 코드다' [ "$rc" -ne 0 ]
assert '  실패 문구에 토큰이 없다' not logged 'test-token'
printf 'TELEGRAM_BOT_TOKEN=bad token"\nTELEGRAM_CHAT_ID=1\n' >/tmp/telegram.env
telegram '글'
assert '형식이 틀린 토큰은 쓰지 않는다' [ "$rc" -ne 0 ]
assert '  값을 출력하지 않는다' not logged 'bad token'
printf 'TELEGRAM_BOT_TOKEN=12345:test-token\nTELEGRAM_CHAT_ID=-100200\n' >/tmp/telegram.env
# refused 설명: 보내지 않고 실패하며, 값을 출력하지 않는다.
refused() {
  rm -f /tmp/curl-args
  telegram '글'
  assert "$1: 실패로 멈춘다" [ "$rc" -ne 0 ]
  assert '  보내지 않는다' not test -e /tmp/curl-args
  assert '  값을 출력하지 않는다' not logged 'test-token'
}
for mode in 640 604 660 400 700; do
  chmod "$mode" /tmp/telegram.env
  refused "토큰 파일 권한 $mode"
done
chmod 600 /tmp/telegram.env
chown 1000 /tmp/telegram.env
refused '토큰 파일이 root 소유가 아니다'
chown 0 /tmp/telegram.env
telegram '글'
assert 'root 소유 600이면 보낸다' equal 0 "$rc"
rm /tmp/telegram.env
refused '토큰 파일이 없다'

