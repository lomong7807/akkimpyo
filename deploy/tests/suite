section '쓰는 중에 백업해도 덤프와 명세표가 같은 시점이다'
docker exec --detach "$TEST_ID-db" psql -X -q -U accountbook -d accountbook -c "
  DO \$\$ BEGIN
    FOR i IN 1..100000 LOOP
      INSERT INTO users VALUES (gen_random_uuid(), 'writer' || i || '@example.com', 'x', 'w', now());
      COMMIT;
      PERFORM pg_sleep(0.001);
    END LOOP;
  END \$\$"
until (($(sql -c 'SELECT count(*) FROM users') > 100)); do sleep 0.1; done
before=$(sql -c 'SELECT count(*) FROM users')
run_backup
after=$(sql -c 'SELECT count(*) FROM users')
sql -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE query LIKE '%writer%' AND pid <> pg_backend_pid()" >/dev/null
assert '0으로 끝난다' equal 0 "$rc"
assert "백업하는 동안 행이 늘었다($before → $after)" [ "$after" -gt "$before" ]
run_drill --store "$STORE" --skip-server
assert '명세표가 맞는다' logged '^- 명세표: 통과'
sql -c "DELETE FROM users WHERE email LIKE 'writer%'"

