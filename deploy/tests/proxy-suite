section 'shellcheck'
assert 'shellcheck' shellcheck "$REPO"/deploy/tests/proxy-run "$REPO"/deploy/tests/proxy-suite "$REPO"/deploy/db-init.sh

section '설치(서버의 /opt/akkimpyo/deploy처럼 작업 폴더에 복사)'
install -d -m 755 "$DEPLOY"
install -m 644 "$REPO"/deploy/compose.yaml "$REPO"/deploy/Caddyfile "$REPO"/deploy/env.allowlist "$DEPLOY/"
install -m 755 "$REPO"/deploy/db-init.sh "$DEPLOY/"
# 시험에서만 쓰는 값. 끝나면 proxy-run이 지운다.
DB_PASSWORD_VALUE=$(openssl rand -hex 32)
KEY_VALUE=$(openssl rand -base64 32)
install -m 600 /dev/null "$ENV_FILE"
printf '%s\n' WEB_ORIGIN=https://localhost DB_URL=jdbc:postgresql://db:5432/accountbook DB_USERNAME=accountbook \
  "DB_PASSWORD=$DB_PASSWORD_VALUE" "ACCESS_TOKEN_SIGNING_KEY=$KEY_VALUE" \
  PROXY_HTTP_PORT=127.0.0.1: PROXY_HTTPS_PORT=127.0.0.1: ACCESS_LOG_KEEP_DAYS= SIGNUP_ALLOWLIST= >"$ENV_FILE"
# 시험에서만: 요청 id가 든 서버 로그를 보려고 오류 응답의 DEBUG 로그를 켠다. 운영 compose에는 없다.
printf '%s\n' 'services:' '  server:' '    environment:' '      LOGGING_LEVEL_APP_ACCOUNTBOOK_API: DEBUG' >"$WORK/override.yaml"

# ---------------------------------------------------------------------------
section '변수 이름: compose, 허용 목록, env.example, 배포 스크립트(B)'
compose_vars=$(grep -o "\\\${[A-Z][A-Z0-9_]*" "$REPO/deploy/compose.yaml" | cut -c3- | sort -u)
expected=$({ cat "$REPO/deploy/env.allowlist"; printf '%s\n' SERVER_IMAGE WEB_IMAGE SW_DISABLE; } | sort -u)
assert 'compose가 읽는 변수는 허용 목록과 배포 파일의 셋(SERVER_IMAGE, WEB_IMAGE, SW_DISABLE)뿐이다' equal "$expected" "$compose_vars"
assert '허용 목록은 이름만 한 줄에 하나다' not grep -qvE '^[A-Z][A-Z0-9_]*$' "$REPO/deploy/env.allowlist"
assert 'env.example의 이름은 허용 목록과 같다' equal "$(sort "$REPO/deploy/env.allowlist")" \
  "$(sed -n 's/^\([A-Z][A-Z0-9_]*\)=.*/\1/p' "$REPO/deploy/env.example" | sort)"
assert 'env.example에 값이 없다' not grep -qE '^[A-Z][A-Z0-9_]*=.+' "$REPO/deploy/env.example"
for name in "${B_REQUIRED[@]}"; do
  assert "배포 스크립트가 요구하는 $name 이 허용 목록에 있다" grep -qx "$name" "$REPO/deploy/env.allowlist"
done
assert 'compose가 env_file을 쓰지 않는다' not grep -qE '^[[:space:]]*env_file:' "$REPO/deploy/compose.yaml"

section 'compose 구성'
dc_prod config --format json >"$WORK/config.json"
cfg() { jq -r "$1" "$WORK/config.json"; }
assert '서비스는 proxy, server, db다' equal 'db proxy server' "$(cfg '.services | keys | join(" ")')"
assert '호스트에 포트를 여는 것은 proxy뿐이다' equal proxy "$(cfg '[.services | to_entries[] | select(.value.ports) | .key] | join(" ")')"
assert 'proxy는 TCP 80과 443만 연다' equal '80/tcp 443/tcp' "$(cfg '[.services.proxy.ports[] | "\(.target)/\(.protocol)"] | join(" ")')"
assert '네트워크는 akkimpyo 하나이고 외부 네트워크가 아니다' equal 'akkimpyo false' \
  "$(cfg '(.networks | keys | join(" ")) + " " + ((.networks.akkimpyo.external // false) | tostring)')"
for s in proxy server db; do
  assert "$s: 메모리 상한과 memswap_limit이 같다" equal true "$(cfg ".services.$s | (.mem_limit != null and .mem_limit == .memswap_limit)")"
  assert "$s: read_only, cap_drop ALL, no-new-privileges" equal 'true ALL no-new-privileges:true' \
    "$(cfg ".services.$s | \"\(.read_only) \(.cap_drop | join(\",\")) \(.security_opt | join(\",\"))\"")"
  assert "$s: 재시작 정책과 compose 안의 로그 순환" equal 'unless-stopped json-file 10m 5' \
    "$(cfg ".services.$s | \"\(.restart) \(.logging.driver) \(.logging.options[\"max-size\"]) \(.logging.options[\"max-file\"])\"")"
  assert "$s: akkimpyo 네트워크에만 붙는다" equal akkimpyo "$(cfg ".services.$s.networks | keys | join(\" \")")"
done
assert 'db 이미지는 digest로 고정돼 있다' matches '^postgres:17[^@]*@sha256:[0-9a-f]{64}$' "$(cfg .services.db.image)"
assert 'db: shm 256m, 체크섬, shared_buffers 256MB, terse' equal '268435456 --data-checksums true true' \
  "$(cfg '.services.db | "\(.shm_size) \(.environment.POSTGRES_INITDB_ARGS) \(.command | any(. == "shared_buffers=256MB")) \(.command | any(. == "log_error_verbosity=terse"))"')"
assert 'server: 프로파일이 local이 아니다' not matches '(^|,)local(,|$)' "$(cfg .services.server.environment.SPRING_PROFILES_ACTIVE)"
assert 'server: JDK_JAVA_OPTIONS가 고정돼 있다' matches 'MaxRAMPercentage' "$(cfg .services.server.environment.JDK_JAVA_OPTIONS)"
assert 'proxy의 사이트 주소와 서버의 WEB_ORIGIN이 같은 값이다' equal https://localhost \
  "$(cfg 'if .services.proxy.environment.SITE_ADDRESS == .services.server.environment.WEB_ORIGIN then .services.proxy.environment.SITE_ADDRESS else "다름" end')"
config_ok() { (ENV_OVERRIDE=${1:-$ENV_FILE} TEST_SERVER_IMAGE=${2-$TEST_SERVER_IMAGE} && dc_prod config --quiet) >/dev/null 2>&1; }
assert '시험 값으로 compose 구성이 만들어진다' config_ok
for name in WEB_ORIGIN DB_URL DB_USERNAME DB_PASSWORD ACCESS_TOKEN_SIGNING_KEY; do
  sed "s/^$name=.*/$name=/" "$ENV_FILE" >"$WORK/missing.env"
  assert "$name 이 비어 있으면 compose가 멈춘다" not config_ok "$WORK/missing.env"
done
assert 'SERVER_IMAGE가 없으면 compose가 멈춘다' not config_ok "$ENV_FILE" ''
rm -f "$WORK/missing.env"

section 'Caddyfile'
caddy_run() { docker run --rm --volume "$DEPLOY/Caddyfile:/etc/caddy/Caddyfile:ro" --env SITE_ADDRESS=https://localhost --env ACCESS_LOG_KEEP_DAYS=14 "$WEB" "$@"; }
assert 'caddy fmt로 바뀌는 곳이 없다' equal "$(sha <"$DEPLOY/Caddyfile")" "$(caddy_run caddy fmt /etc/caddy/Caddyfile 2>/dev/null | sha)"
caddy_run caddy adapt --config /etc/caddy/Caddyfile 2>/dev/null >"$WORK/caddy.json"
assert '모든 서버(80, 443)에 머리글 읽기 10초, 요청 읽기 10초, HTTP/1.1·HTTP/2만' equal '10000000000 10000000000 h1,h2' \
  "$(jq -r '[.apps.http.servers[] | "\(.read_header_timeout) \(.read_timeout) \(.protocols | join(","))"] | unique | join(";")' "$WORK/caddy.json")"
assert '접근 로그는 14일 남기고 하루마다 나눈다' equal '14 86400000000000 0600' \
  "$(jq -r '.logging.logs[] | select(.writer.output == "file") | "\(.writer.roll_keep_days) \(.writer.roll_interval) \(.writer.mode)"' "$WORK/caddy.json")"

