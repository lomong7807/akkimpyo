#!/usr/bin/env bash
# deploy/tests/proxy-run이 시험 컨테이너 안에서 부른다. 하나라도 어긋나면 그 자리에서 1로 끝난다.
# 운영 compose를 서버에 설치하듯 작업 폴더에 복사해 띄우고, 프록시에 compose 네트워크 안에서 붙는다.
set -euo pipefail
export LC_ALL=C.UTF-8

: "${TEST_ID:?}" "${REPO:?}" "${WORK:?}" "${TEST_SERVER_IMAGE:?}" "${TEST_WEB_IMAGE:?}"
QUICK=${PROXY_TEST_QUICK:-0}
DEPLOY=$WORK/deploy
ENV_FILE=$WORK/app.env
NET=${TEST_ID}_akkimpyo
CA=$WORK/root.crt
H=$WORK/h
B=$WORK/b
LOG=$WORK/log
UUID='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
# 배포 스크립트(B, deploy/bin/deploy)가 env 파일에 꼭 있어야 한다고 보는 이름.
B_REQUIRED=(DB_URL DB_USERNAME DB_PASSWORD ACCESS_TOKEN_SIGNING_KEY WEB_ORIGIN)
WEB=$TEST_WEB_IMAGE
SW=no
: >"$LOG"

section() { printf '\n[%3d초] %s\n' "$SECONDS" "$1"; }

# assert 설명 명령...
assert() {
  local what=$1
  shift
  if ! "$@"; then
    printf '  실패: %s\n' "$what"
    if [[ -s $H ]]; then
      printf -- '--- 마지막 응답 머리글\n'
      cat "$H"
    fi
    if [[ -s $LOG ]]; then
      printf -- '--- 마지막 출력\n'
      tail -n 40 "$LOG"
    fi
    exit 1
  fi
  printf '  ok: %s\n' "$what"
}
not() { ! "$@"; }
equal() { [[ $1 == "$2" ]] || { printf '    기대 "%s", 실제 "%s"\n' "$1" "$2"; false; }; }
differ() { [[ $1 != "$2" ]] || { printf '    둘 다 "%s"\n' "$1"; false; }; }
matches() { [[ $2 =~ $1 ]] || { printf '    "%s"이 %s에 맞지 않는다\n' "$2" "$1"; false; }; }
between() { awk -v v="$1" -v lo="$2" -v hi="$3" 'BEGIN { exit !(v >= lo && v <= hi) }' || { printf '    %s이 %s~%s 밖이다\n' "$1" "$2" "$3"; false; }; }
contains() { grep -qF -- "$2" "$1"; }
now() { date +%s.%N; }
since() { awk -v a="$1" -v b="$(now)" 'BEGIN { printf "%.1f", b - a }'; }

# 운영과 같은 compose 사본, 같은 env 파일. 시험에서만 쓰는 덮어쓰기 파일(override.yaml)을 더한다.
dc_prod() {
  SERVER_IMAGE=$TEST_SERVER_IMAGE WEB_IMAGE=$WEB SW_DISABLE=$SW docker compose --progress quiet \
    --project-name "$TEST_ID" --file "$DEPLOY/compose.yaml" --env-file "${ENV_OVERRIDE:-$ENV_FILE}" "$@"
}
dc() {
  SERVER_IMAGE=$TEST_SERVER_IMAGE WEB_IMAGE=$WEB SW_DISABLE=$SW docker compose --progress quiet \
    --project-name "$TEST_ID" --file "$DEPLOY/compose.yaml" --file "$WORK/override.yaml" --env-file "$ENV_FILE" "$@"
}
cid() { dc ps --all --quiet "$1"; }
inspect() { docker inspect --format "$2" "$(cid "$1")"; }

# 프록시에 붙는다. SNI와 Host는 운영과 같은 사이트 주소(localhost)다.
web() { curl --silent --show-error --cacert "$CA" --connect-to ::proxy: "$@"; }
# req 경로 [curl 인자...]: 머리글은 $H, 본문은 $B, 상태 코드는 $code.
req() {
  local path=$1
  shift
  code=$(web --output "$B" --dump-header "$H" --write-out '%{http_code}' "$@" "https://localhost$path")
}
header() { sed -n "s/\r\$//; s/^$1: //Ip" "$H" | sed -n 1p; }
no_header() { ! grep -qi "^$1:" "$H"; }
body_has() { grep -qF -- "$1" "$B"; }
sha() { sha256sum | cut -d' ' -f1; }

# 프록시가 붙이는 보안 헤더(#52 범위 보강 16)와 지우는 헤더(범위 보강 5). https 응답에 쓴다.
security_headers() {
  equal nosniff "$(header X-Content-Type-Options)" &&
    equal DENY "$(header X-Frame-Options)" &&
    equal "frame-ancestors 'none'" "$(header Content-Security-Policy)" &&
    equal max-age=31536000 "$(header Strict-Transport-Security)" &&
    no_header Server && no_header Via &&
    matches "$UUID" "$(header X-Request-Id)"
}
# 프록시 자신이 낸 오류 응답.
proxy_error() {
  equal "$1" "$code" && security_headers && equal no-store "$(header Cache-Control)" &&
    equal 'text/plain; charset=utf-8' "$(header Content-Type)"
}
# 서버가 낸 응답(ADR 002의 problem+json).
from_server() {
  equal application/problem+json "$(header Content-Type)" && security_headers && body_has "\"requestId\":\"$(header X-Request-Id)\""
}

wait_proxy() {
  for _ in $(seq 60); do
    if web --output /dev/null --fail https://localhost/ 2>/dev/null; then return 0; fi
    sleep 0.5
  done
  return 1
}

# 배포 스크립트(B)의 copy_assets와 같은 명령으로, 돌고 있는 웹의 /srv/assets를 assets-prev 볼륨에 남긴다(범위 보강 21).
keep_assets() {
  local volume
  volume=$(docker volume ls --quiet --filter "label=com.docker.compose.project=$TEST_ID" \
    --filter label=com.docker.compose.volume=assets-prev)
  docker cp "$(cid proxy):/srv/assets/." - |
    docker run --rm -i --name "$TEST_ID-copy" --network none --user 0:0 --cap-drop ALL --security-opt no-new-privileges \
      --read-only --memory 128m --mount "type=volume,src=$volume,dst=/dst" --entrypoint /bin/sh "$WEB" \
      -c 'find /dst -mindepth 1 -delete && tar -x -o -f - -C /dst'
}

# web_version 이미지 파일: 웹 이미지에서 /srv/assets만 그 파일 하나로 바꾼 판을 만든다.
web_version() {
  printf '%s\n' "FROM $TEST_WEB_IMAGE" 'USER 0:0' \
    "RUN rm -rf /srv/assets && mkdir /srv/assets && echo '$2' > /srv/assets/$2 && chmod 644 /srv/assets/$2" \
    'USER 10001:10001' | docker build --quiet --tag "$1" - >/dev/null
}

