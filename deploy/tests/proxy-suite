if [[ $QUICK == 1 ]]; then
  section '오래 걸리는 시험(느린 연결, 유지 연결, DB 내림)은 PROXY_TEST_QUICK=1이라 건너뛴다. CI에서 돈다'
else
  section '느린 머리글과 느린 본문은 10초 안팎에 끊기고 그동안 다른 요청이 된다(범위 보강 19, 20)'
  mkdir -p "$WORK/slow"
  slow_header() {
    local start
    start=$(now)
    { printf 'GET / HTTP/1.1\r\nHost: localhost\r\n'; for i in $(seq 30); do sleep 1; printf 'X-Slow-%d: a\r\n' "$i"; done; } |
      timeout 45 openssl s_client -quiet -connect proxy:443 -servername localhost -CAfile "$CA" >/dev/null 2>&1 || true
    since "$start" >"$WORK/slow/header-$1"
  }
  # 1초에 1,000바이트씩 쉬지 않고 30,000바이트. 다음 바이트가 아니라 요청 전체에 제한 시간이 걸리면 10초에 끊긴다.
  slow_body() {
    local start
    start=$(now)
    head -c 30000 /dev/zero | web --http1.1 --limit-rate 1000 --max-time 45 --output /dev/null -X POST \
      -H 'Content-Type: application/json' --data-binary @- https://localhost/api/v1/slow >/dev/null 2>&1 || true
    since "$start" >"$WORK/slow/body-$1"
  }
  for i in $(seq 20); do
    slow_header "$i" &
    slow_body "$i" &
  done
  sleep 3
  for _ in 1 2 3; do
    t=$(web --output /dev/null --write-out '%{http_code} %{time_total}' https://localhost/) || t='실패 99'
    assert "느린 연결 40개가 붙어 있는 동안 /가 2초 안에 온다(${t})" between "${t#* }" 0 2
    assert '그때 /는 200이다' equal 200 "${t%% *}"
    t=$(web --output /dev/null --write-out '%{http_code} %{time_total}' -X POST --data-binary '{}' \
      -H 'Content-Type: application/json' https://localhost/api/v1/ping) || t='실패 99'
    assert "그동안 /api도 서버가 2초 안에 답한다(${t})" between "${t#* }" 0 2
    assert '그때 /api는 502가 아니다' matches '^4[0-9][0-9]$' "${t%% *}"
    sleep 1
  done
  wait
  for f in "$WORK"/slow/*; do
    assert "$(basename "$f")가 $(cat "$f")초에 끊겼다" between "$(cat "$f")" 9 14
  done

  section '프록시와 서버 사이의 유지 연결을 쉬게 한 뒤 POST(범위 보강 20)'
  req /api/v1/keepalive -X POST -H 'Content-Type: application/json' --data-binary '{}'
  for gap in 6 11 15; do
    sleep "$gap"
    req /api/v1/keepalive -X POST -H 'Content-Type: application/json' --data-binary '{}'
    assert "${gap}초 쉰 뒤의 POST가 502가 아니라 서버의 응답이다($code)" from_server
  done

  section 'DB를 내리면 서버는 unhealthy로만 표시되고 재시작하지 않는다(범위 보강 14 정정)'
  dc stop db >"$LOG" 2>&1
  # DB가 없으면 상태 확인이 DB 연결을 기다린다(Hikari의 기본 대기 30초). 그동안은 응답이 없다.
  start=$(now)
  health=$(dc exec -T server curl --silent --max-time 60 --write-out ' %{http_code}' http://127.0.0.1:8080/actuator/health || true)
  assert "DB가 내려가면 /actuator/health가 503 DOWN이다($(since "$start")초 걸림: $health)" matches '"status":"DOWN".* 503$' "$health"
  for _ in $(seq 90); do
    [[ $(inspect server '{{.State.Health.Status}}') == unhealthy ]] && break
    sleep 1
  done
  assert '서버 컨테이너가 unhealthy가 됐다' equal unhealthy "$(inspect server '{{.State.Health.Status}}')"
  assert '서버 컨테이너는 재시작하지 않고 계속 돈다' equal 'running 0' "$(inspect server '{{.State.Status}} {{.RestartCount}}')"
  dc start db >"$LOG" 2>&1
  for _ in $(seq 120); do
    [[ $(inspect server '{{.State.Health.Status}}') == healthy ]] && break
    sleep 1
  done
  assert 'DB가 돌아오면 서버가 다시 healthy다' equal healthy "$(inspect server '{{.State.Health.Status}}')"
fi

