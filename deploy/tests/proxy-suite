section '세 컨테이너 띄우기'
if ! dc up --detach --wait --wait-timeout 300 >"$LOG" 2>&1; then
  cat "$LOG"
  dc logs --no-color 2>&1 | tail -n 100
  exit 1
fi
assert 'proxy, server, db가 돈다' equal 'db proxy server' "$(dc ps --services --status running | sort | tr '\n' ' ' | sed 's/ $//')"
docker network connect "$NET" "$TEST_ID-suite"
for _ in $(seq 60); do
  dc cp proxy:/data/caddy/pki/authorities/local/root.crt "$CA" >/dev/null 2>&1 && break
  sleep 0.5
done
assert '프록시가 내부 CA로 localhost 인증서를 냈다(시험에서만, 운영은 ACME)' wait_proxy

section '컨테이너 강화(실행 중인 설정)'
for s in proxy server db; do
  assert "$s: 읽기 전용, 모든 권한 뺌, no-new-privileges, 스왑 없음" equal 'true [ALL] [no-new-privileges:true] true' \
    "$(inspect "$s" '{{.HostConfig.ReadonlyRootfs}} {{.HostConfig.CapDrop}} {{.HostConfig.SecurityOpt}} {{eq .HostConfig.Memory .HostConfig.MemorySwap}}')"
done
assert 'server와 db는 호스트에 포트를 열지 않는다' equal '0 0' \
  "$(inspect server '{{len .HostConfig.PortBindings}}') $(inspect db '{{len .HostConfig.PortBindings}}')"
assert 'proxy는 root가 아닌 10001로 80·443을 연다' equal 10001 "$(dc exec -T proxy id -u)"
assert 'proxy의 80·443이 호스트(시험에서는 127.0.0.1)에 열렸다' matches '^127\.0\.0\.1:[0-9]+ 127\.0\.0\.1:[0-9]+$' \
  "$(dc port proxy 80) $(dc port proxy 443)"

