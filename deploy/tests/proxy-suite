section 'DB(범위 보강 10, 체크섬, 로그, 역할)'
psql_admin() { dc exec -T db psql -X -q -A -t -v ON_ERROR_STOP=1 -U postgres -d postgres "$@"; }
assert '체크섬, shared_buffers, terse, lc_messages, 값이 찍히는 로그 설정은 기본값' \
  equal 'on|256MB|terse|en_US.utf8|none|-1|0' \
  "$(psql_admin -c "SELECT concat_ws('|', current_setting('data_checksums'), current_setting('shared_buffers'),
      current_setting('log_error_verbosity'), current_setting('lc_messages'), current_setting('log_statement'),
      current_setting('log_min_duration_statement'), current_setting('log_parameter_max_length_on_error'))")"
assert '서버의 역할은 슈퍼유저가 아니고 운영 DB의 소유자다' equal 'f|f|f|accountbook' \
  "$(psql_admin -c "SELECT concat_ws('|', rolsuper, rolcreatedb, rolcreaterole,
      (SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname = 'accountbook')) FROM pg_roles WHERE rolname = 'accountbook'")"
assert '관리 역할(postgres)에는 비밀번호가 없다' equal t "$(psql_admin -c "SELECT rolpassword IS NULL FROM pg_authid WHERE rolname = 'postgres'")"
assert '마이그레이션은 서버의 역할로 적용됐다' equal accountbook \
  "$(dc exec -T db psql -X -A -t -U postgres -d accountbook -c 'SELECT DISTINCT installed_by FROM flyway_schema_history')"
db_client() {
  docker run --rm --name "$TEST_ID-psql" --network "$NET" --env "PGPASSWORD=$DB_PASSWORD_VALUE" --entrypoint psql \
    "$(cfg .services.db.image)" -X -A -t -h db "$@" -c 'SELECT 1'
}
assert '다른 컨테이너에서 서버의 역할로 비밀번호로 접속한다' equal 1 "$(db_client -U accountbook -d accountbook 2>/dev/null)"
admin_over_tcp() { db_client -U postgres -d postgres >/dev/null 2>&1; }
assert '다른 컨테이너에서 관리 역할로는 접속하지 못한다' not admin_over_tcp
printf '    마이그레이션용과 앱용(DML만) 역할 분리는 하지 않았다(dba의 정의 전, 다른 이슈). 앱 계정의 DDL 거부 시험도 그때 한다.\n'
check_value=check-secret-$RANDOM$RANDOM
printf '%s\n' "CREATE TEMP TABLE t (v text CHECK (v = 'ok'));" "INSERT INTO t VALUES (\$1) \\bind '$check_value' \\g" |
  dc exec -T db psql -X -q -U accountbook -d accountbook >"$LOG" 2>&1 || true
assert 'CHECK 위반이 났다' contains "$LOG" 'violates check constraint'
dc logs --no-color db >"$WORK/db.log" 2>&1
assert 'DB 로그에 CHECK 위반이 남았다' contains "$WORK/db.log" 'violates check constraint'
assert 'DB 로그에 위반한 값이 없다' not contains "$WORK/db.log" "$check_value"
assert 'DB 로그에 행의 값을 싣는 DETAIL이 없다(terse)' not contains "$WORK/db.log" 'Failing row'

section '로그에 비밀값이 없다'
dc logs --no-color >"$WORK/all.log" 2>&1
assert 'DB 비밀번호가 어느 컨테이너 로그에도 없다' not contains "$WORK/all.log" "$DB_PASSWORD_VALUE"
assert '서명 키가 어느 컨테이너 로그에도 없다' not contains "$WORK/all.log" "$KEY_VALUE"

