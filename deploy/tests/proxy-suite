section '서버가 내려가 있을 때(502)와 서버로 넘어가는 요청(대역 서버)'
dc stop server >"$LOG" 2>&1
req /api/v1/ping
assert '서버를 내리면 프록시의 502, 보안 헤더' proxy_error 502
docker run --detach --name "$TEST_ID-echo" --network "$NET" --network-alias server \
  --volume "$REPO/deploy/tests/proxy-echo.Caddyfile:/etc/caddy/Caddyfile:ro" "$TEST_WEB_IMAGE" >/dev/null
for _ in $(seq 40); do curl --silent --fail --output /dev/null http://server:8080/ && break; sleep 0.5; done
echo_log() { docker logs "$TEST_ID-echo" 2>/dev/null | jq -c --arg p "$1" 'select(.msg == "handled request" and .request.uri == $p)'; }
field() { tr '|' '\n' <"$B" | sed -n "s/^$1=//p"; }
suite_ip=$(docker inspect --format "{{(index .NetworkSettings.Networks \"$NET\").IPAddress}}" "$TEST_ID-suite")
req /api/v1/echo -H 'X-Forwarded-For: 203.0.113.9' -H 'X-Forwarded-Proto: http' -H 'X-Forwarded-Host: evil.example' \
  -H 'X-Forwarded-Prefix: /evil' -H 'X-Forwarded-Port: 1234' -H 'Forwarded: for=203.0.113.9' -H "X-Request-Id: $client_id"
assert 'X-Forwarded-For는 프록시가 본 주소 하나다' equal "$suite_ip" "$(field xff)"
assert 'X-Forwarded-Proto, Host는 프록시가 정한다' equal 'https localhost' "$(field proto) $(field host)"
assert '밖에서 온 X-Forwarded-Prefix, X-Forwarded-Port, Forwarded는 지운다' equal '||' "$(field prefix)|$(field port)|$(field forwarded)"
assert '서버로 가는 X-Request-Id는 응답과 같은 새 값이다' equal "$(header X-Request-Id)" "$(field rid)"
start=$(now)
head -c 5000 /dev/zero | web --http1.1 --limit-rate 1000 --output "$B" -X POST -H 'Transfer-Encoding: chunked' -T - \
  https://localhost/api/v1/slow-ok
# 대역 서버의 로그는 처리가 끝난 시각(ts)과 처리에 걸린 시간(duration)을 남긴다. 프록시가 본문을 흘려보냈다면
# 서버 자리가 본문을 기다리느라 duration이 몇 초가 된다.
read -r done_at took got < <(echo_log /api/v1/slow-ok | jq -r '"\(.ts) \(.duration) \(.bytes_read)"') || true
assert '5초에 걸쳐 나눠 보낸 본문이 서버 자리에 닿았다' equal https "$(field proto)"
assert "프록시가 본문을 다 받은 뒤 넘겨 서버 자리는 본문을 기다리지 않았다(처리 ${took}초)" between "$took" 0 1
assert '서버 자리에 요청이 닿은 것은 본문을 다 보낸 뒤다(시작 4초 뒤 이후)' \
  awk -v a="$start" -v r="$done_at" 'BEGIN { exit !(r - a >= 4) }'
assert '서버 자리가 받은 본문은 5000바이트다' equal 5000 "$got"
head -c 60000000 /dev/zero | web --http1.1 --output /dev/null -X POST -H 'Transfer-Encoding: chunked' -T - \
  https://localhost/api/v1/big || true
big=$(echo_log /api/v1/big | jq -s 'map(.bytes_read) | add // 0')
printf '    60MB 요청에서 서버 자리가 받은 본문: %s바이트\n' "$big"
assert '60MB 요청은 서버 자리에 상한(65,536바이트)보다 많이 닿지 않는다' between "$big" 0 65536
docker rm --force "$TEST_ID-echo" >/dev/null
dc up --detach --wait --wait-timeout 180 server >"$LOG" 2>&1
assert '서버를 다시 띄웠다' wait_proxy

